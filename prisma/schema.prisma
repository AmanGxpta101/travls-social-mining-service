generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenStatus {
  active
  expired
  revoked
}

// Which share flow a share went through, and which reward thresholds apply to it.
// kol: ops-allowlisted, posted directly via the X API on the user's behalf
// ($0.20/post). community: everyone else — they post the template themselves
// and submit the post id back; we verify with one app-only read ($0.005).
enum ShareTier {
  kol
  community
}

enum PostStatus {
  pending_confirmation
  confirmed
  deleted
  // Ops rejected the submission. The task counts as not done, so the user can
  // do it again (with a new post — this one stays claimed).
  invalidated
}

model UserSocialAccount {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  platform         String      @default("x")
  externalUserId   String      @map("external_user_id")
  handle           String
  accessTokenEnc   String      @map("access_token_enc")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenEnc  String?     @map("refresh_token_enc")
  tokenStatus      TokenStatus @default(active) @map("token_status")
  connectedAt      DateTime    @default(now()) @map("connected_at")
  // The Travls user this account is linked to, once they've come in from the
  // cards dashboard with Travls sync on. Our userId never changes; points go
  // to this id. Null = standalone: points are held here until linked.
  travlsUserId     String?     @unique @map("travls_user_id")
  travlsLinkedAt   DateTime?   @map("travls_linked_at")

  @@unique([userId, platform])
  // One Travls user per X account — otherwise a single X account could farm
  // every task once per Travls account it's linked to.
  @@unique([platform, externalUserId])
  @@map("user_social_account")
}

model SocialShare {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  // Unique so the same post can't be claimed by two shares.
  externalPostId String?     @unique @map("external_post_id")
  copyVariant    String      @default("v1_static") @map("copy_variant")
  tier           ShareTier   @default(kol)
  // community tier only: per-share code embedded in the template's link, which
  // verification requires to be present in the submitted post.
  refCode        String?     @unique @map("ref_code")
  // The X account that actually posted, captured at post/verify time. The
  // user's connected account can change later, so ops must not derive a
  // share's handle from it. Null on community shares until verified.
  authorXUserId  String?     @map("author_x_user_id")
  authorHandle   String?     @map("author_handle")
  invalidatedReason String?  @map("invalidated_reason")
  invalidatedBy     String?  @map("invalidated_by")
  invalidatedAt     DateTime? @map("invalidated_at")
  postStatus     PostStatus  @default(pending_confirmation) @map("post_status")
  // The challenge's photo bonus this submission earned (its post had a
  // photo), fixed at verify time; part of its completion credit.
  photoBonus     Int         @default(0) @map("photo_bonus")
  sharedAt       DateTime    @default(now()) @map("shared_at")

  snapshots     EngagementSnapshot[]
  manualCredits ManualCredit[]

  @@map("social_share")
}

model EngagementSnapshot {
  id         String   @id @default(uuid())
  shareId    String   @map("share_id")
  likes          Int      @default(0)
  retweets       Int      @default(0)
  quoteCount     Int      @default(0) @map("quote_count")
  replies        Int      @default(0)
  bookmarkCount  Int      @default(0) @map("bookmark_count")
  impressionCount Int     @default(0) @map("impression_count")
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  share SocialShare @relation(fields: [shareId], references: [id])

  @@map("engagement_snapshot")
}

// Short-lived record bridging /connect/init -> /connect/callback (PKCE verifier +
// platform). Kept in the DB rather than in-memory so a service restart
// mid-event doesn't strand an in-flight OAuth handshake. No user: connecting is
// how a user gets their ID (the X account decides it, see ConnectService).
model PendingOAuthState {
  state     String   @id
  userId    String?  @map("user_id")
  platform  String
  verifier  String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("pending_oauth_state")
}

model RewardThreshold {
  id       String    @id @default(uuid())
  metric   String
  tier     ShareTier @default(kol)
  minValue Int       @map("min_value")
  active   Boolean   @default(true)

  @@unique([metric, tier])

  @@map("reward_threshold")
}

model ManualCredit {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  shareId  String   @map("share_id")
  amount   Decimal
  issuedBy String   @map("issued_by")
  issuedAt DateTime @default(now()) @map("issued_at")

  share SocialShare @relation(fields: [shareId], references: [id])

  @@map("manual_credit")
}

// Users ops has marked as KOLs — their shares take the direct-post flow.
// Everyone else gets the clipboard template + paste-back flow.
model KolAllowlist {
  userId  String   @id @map("user_id")
  addedBy String   @map("added_by")
  addedAt DateTime @default(now()) @map("added_at")

  @@map("kol_allowlist")
}

// A KOL ops added by X handle before that account connected. Connecting X
// with this handle promotes it into kol_allowlist (see ConnectService). Stored
// lowercase: X handles are case-insensitive.
model KolInvite {
  handle  String   @id
  addedBy String   @map("added_by")
  addedAt DateTime @default(now()) @map("added_at")

  @@map("kol_invite")
}

// Challenges users can complete. Ops can add and retire them from the
// dashboard; a share records its challenge id in copy_variant.
model ShareTask {
  id          String   @id
  title       String
  description String
  // `{link}` (optional, at most once) becomes the landing / per-share ref link.
  template    String
  points      Int
  // Public URL of the image posted with this challenge (Supabase Storage).
  // Null means KOL posts carry the default promo image and community posts none.
  imageUrl    String?  @map("image_url")
  // Last moment a submission counts (end of the chosen day, IST). Null means
  // the challenge runs until ops archives it. Past it, users who connected
  // before it and hadn't completed it see it as missed.
  deadline    DateTime?
  // Extra points when the user's post carries a photo of their own. 0 = none.
  photoBonus  Int      @default(0) @map("photo_bonus")
  active      Boolean  @default(true)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("share_task")
}

// Ops disabled one challenge for one user.
model TaskBlock {
  userId    String   @map("user_id")
  taskId    String   @map("task_id")
  reason    String
  blockedBy String   @map("blocked_by")
  blockedAt DateTime @default(now()) @map("blocked_at")

  @@id([userId, taskId])
  @@map("task_block")
}

// Points ops took away (stored negative), with the reason shown to the user.
model PointsAdjustment {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  shareId  String?  @map("share_id")
  amount   Int
  reason   String
  issuedBy String   @map("issued_by")
  issuedAt DateTime @default(now()) @map("issued_at")

  @@index([userId])
  @@map("points_adjustment")
}

enum PointsEntryStatus {
  // Recorded here, not yet accepted by Travls — held while the user is
  // unlinked or Travls sync is off, retried by the sync job otherwise.
  pending
  synced
  failed
}

// The change log for every write to a user's Travls points. Travls' own
// points are the currency (decided 2026-09-29, "scenario 1"), so their backend
// holds the balance and we add/remove on it. One row per add or remove; reads
// are never logged. Rows are the outbox too: written before the call to
// Travls, retried until synced, and keyed so a retry can't double-apply.
model PointsLedgerEntry {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  // Signed: positive adds, negative removes.
  amount         Int
  // Ours, not Travls' — the entry is pushed to the account's travlsUserId once linked.
  // Shown to the user and sent to Travls, e.g. `Completed "Announce you joined Travls"`.
  reason         String
  // challenge_completed | challenge_revoked | ops_deduction
  kind           String
  shareId        String?           @map("share_id")
  adjustmentId   String?           @map("adjustment_id")
  idempotencyKey String            @unique @map("idempotency_key")
  status         PointsEntryStatus @default(pending)
  // Travls' balance just before and after this write — "200 -> 300".
  balanceBefore  Int?              @map("balance_before")
  balanceAfter   Int?              @map("balance_after")
  attempts       Int               @default(0)
  lastError      String?           @map("last_error")
  createdBy      String            @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  syncedAt       DateTime?         @map("synced_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("points_ledger_entry")
}

// Our copy of each Travls user's balance, keyed by their Travls user id.
// Refreshed on every session check and every points write.
model TravlsPointsBalance {
  userId    String   @id @map("user_id")
  balance   Int
  fetchedAt DateTime @map("fetched_at")

  @@map("travls_points_balance")
}

// Every HTTP call to the Travls points API, as sent and as answered — for
// checking the integration by eye. The access token is stored masked; the
// signature is kept whole (it's useless without the secret). Pruned after 14 days.
model TravlsApiCall {
  id              String   @id @default(uuid())
  at              DateTime @default(now())
  method          String
  path            String
  // The Travls user the call was about, when known (unknown for a session check that failed).
  userId          String?  @map("user_id")
  requestHeaders  Json     @map("request_headers")
  // The exact body string sent — what the signature covers.
  requestBody     String?  @map("request_body")
  status          Int?
  responseBody    String?  @map("response_body")
  // Network failure / timeout, when Travls never answered.
  error           String?
  durationMs      Int      @map("duration_ms")

  @@index([at])
  @@index([userId, at])
  @@map("travls_api_call")
}

// Runtime switches ops flip from the dashboard. `travls_sync`: { on: boolean }.
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_setting")
}
