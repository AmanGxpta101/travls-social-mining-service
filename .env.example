# Postgres — reuse the org's existing instance if there is one (see plan §6)
DATABASE_URL="postgresql://user:password@localhost:5432/social_mining"

# X (Twitter) API v2 — OAuth 2.0 Client ID/Secret (NOT the "Consumer Key"/"API
# Key Secret" the portal shows by default — those sign OAuth 1.0a requests and
# are unused here). Client ID/Secret only appear after you turn on "User
# authentication settings" on the app: set App permissions to Read and write
# (tweet.write, per decision on record), Type of App to a confidential client
# (e.g. "Web App, Automated App or Bot"), and Callback URI to match
# X_REDIRECT_URI_WEB/MOBILE below exactly.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI_WEB="https://app.travls.com/social-mining/callback"
X_REDIRECT_URI_MOBILE="travls://social-mining/callback"

# App-only Bearer Token — this one IS shown by default on the portal's "Keys
# and tokens" tab. Used for engagement reads: public_metrics only needs
# app-only auth, not a user's OAuth token, so this is unrelated to Client ID/
# Secret above.
X_BEARER_TOKEN=""

# Token encryption at rest — NOT issued by X, generate locally:
# `openssl rand -base64 32`. App-level key until org KMS is wired in (see plan §6).
TOKEN_ENCRYPTION_KEY=""

# Existing wallet/credit ledger service (open question #6 in the plan — stubbed until answered)
LEDGER_API_URL=""
LEDGER_API_KEY=""

PORT=3001

# Ops-only routes (/v1/ops/*) authenticate with this shared key via the
# `x-ops-key` header, not a user session. Generate one locally, e.g.
# `openssl rand -hex 24`, and give the same value to the internal ops
# dashboard's server-side config.
OPS_API_KEY=""
